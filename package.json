{
  "name": "pinyin-chart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:native": "tsc --noEmit && vite build --mode native",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:sources": "tsx scripts/fetch-sources.ts",
    "data:build": "tsx scripts/build-data.ts",
    "data:audio": "tsx scripts/build-audio.ts",
    "data:fonts": "python3 scripts/build-fonts.py",
    "data:icons": "python3 scripts/build-icons.py",
    "data:notices": "tsx scripts/build-notices.ts",
    "data:open": "tsx scripts/build-open-data.ts",
    "data:all": "npm run data:sources && npm run data:build && npm run data:audio && npm run data:fonts && npm run data:notices && npm run data:open",
    "check:native": "tsx scripts/check-native-config.ts",
    "android:sync": "npm run build:native && cap sync android",
    "android:debug": "npm run android:sync && tsx scripts/gradle.ts assembleDebug",
    "android:bundle": "npm run android:sync && npm run check:native && tsx scripts/gradle.ts bundleRelease",
    "android:apk": "tsx scripts/require-signing.ts && npm run android:sync && npm run check:native && tsx scripts/gradle.ts assembleRelease",
    "android:open": "cap open android",
    "android:livereload": "tsx scripts/android-livereload.ts",
    "android:assets": "tsx scripts/android-assets.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@preact/signals": "^2.11.4",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "lucide-preact": "^1.72.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "description": "An interactive Mandarin pinyin chart: native audio, example characters, your own notes and recordings. Offline-first PWA.",
  "engines": {
    "node": ">=22"
  }
}
